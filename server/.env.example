NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/stayos
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=15m
CLIENT_URL=http://localhost:5173
COOKIE_SECRET=change-me-to-another-long-random-string
CSRF_ENABLED=false
# Reverse-proxy hops in front of the API (0 = none). Set to 1 behind a single load balancer.
TRUST_PROXY=0
# Comma-separated hosts complaint attachment URLs may use (exact or *.wildcard). Empty = none accepted.
# Swap point: once file uploads exist, the signed-URL host goes here.
ATTACHMENT_ALLOWED_HOSTS=
# Email: leave SMTP_URL empty to log emails as JSON (dev). Production example:
# SMTP_URL=smtps://user:password@smtp.example.com:465
EMAIL_ENABLED=true
EMAIL_FROM=StayOS <no-reply@stayos.local>
# Daily jobs (rent reminders, overdue reconcile, upcoming move-ins/outs). Off by default.
ENABLE_CRON=false
# Razorpay Standard Checkout (dashboard.razorpay.com > Settings > API Keys). Empty = online payments off (503).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
