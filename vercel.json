{
  "installCommand": "npm install --include=dev && npm install --include=dev --prefix server && npm install --include=dev --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": { "api/index.js": { "maxDuration": 30, "includeFiles": "server/src/**" } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
